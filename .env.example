# Maxine Creator Dashboard - 环境变量配置
# 复制此文件为 .env 并填入你的 API Key

# OpenAI API Key（用于视频分析、OCR截图识别、反思分类、人生教练问答）
# 获取地址：https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# API 提供商：openai 或 claude（用于视频分析，反思模块固定使用 OpenAI）
API_PROVIDER=openai

# AI 模型（用于反思分类和人生教练问答，默认 gpt-4o-mini）
AI_MODEL=gpt-4o-mini

# 服务器端口
PORT=3000
